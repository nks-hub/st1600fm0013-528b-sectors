+struct sd_528_bounce_chunk {
+	struct page *page;
+	unsigned int len;
+};
+
+#define SD_528_MAX_CHUNK_ORDER	4
+#define SD_528_CHUNK_BYTES	(PAGE_SIZE << SD_528_MAX_CHUNK_ORDER)
+#define SD_528_HOST_SECTOR_SIZE	512U
+#define SD_528_DEV_SECTOR_SIZE	528U
+#define SD_528_TRAILER_BYTES	(SD_528_DEV_SECTOR_SIZE - SD_528_HOST_SECTOR_SIZE)
+#define SD_528_BLOCKS_PER_CHUNK	(SD_528_CHUNK_BYTES / SD_528_DEV_SECTOR_SIZE)
+#define SD_528_CHUNK_USED_BYTES	(SD_528_BLOCKS_PER_CHUNK * SD_528_DEV_SECTOR_SIZE)
+#define SD_528_DEFAULT_MAX_SECTORS	2048U
+#define SD_528_MAX_HOST_SECTORS	4096U
+#define SD_528_MAX_CHUNKS	DIV_ROUND_UP(SD_528_MAX_HOST_SECTORS, \
+					 SD_528_BLOCKS_PER_CHUNK)
+
+struct sd_528_emulation_ctx {
+	struct scsi_data_buffer orig_sdb;
+	struct sg_table bounce_sgt;
+	unsigned int host_len;
+	unsigned int dev_len;
+	unsigned int nr_chunks;
+	struct scatterlist bounce_sgl[SD_528_MAX_CHUNKS];
+	struct sd_528_bounce_chunk chunks[SD_528_MAX_CHUNKS];
+};
+
+static unsigned int sd_528_effective_max_sectors(void)
+{
+	unsigned int max_sectors = sd_528_emulation_max_sectors;
+
+	if (!max_sectors)
+		max_sectors = SD_528_DEFAULT_MAX_SECTORS;
+
+	return min_t(unsigned int, max_sectors, SD_528_MAX_HOST_SECTORS);
+}
+
+static unsigned int sd_528_blocks_to_chunks(unsigned int blocks)
+{
+	return DIV_ROUND_UP(blocks, SD_528_BLOCKS_PER_CHUNK);
+}
+
+static unsigned int sd_528_segments_to_sectors(unsigned int max_segments)
+{
+	if (!max_segments)
+		return UINT_MAX;
+
+	if (max_segments > UINT_MAX / SD_528_BLOCKS_PER_CHUNK)
+		return UINT_MAX;
+
+	return max_segments * SD_528_BLOCKS_PER_CHUNK;
+}
+
+static unsigned int sd_528_queue_depth_cap(void)
+{
+	unsigned int chunks = sd_528_blocks_to_chunks(sd_528_effective_max_sectors());
+	unsigned int page_cap = max_t(unsigned int, 1,
+				      SD_528_MEMPOOL_SIZE / chunks);
+
+	return min_t(unsigned int, page_cap, SD_528_CTX_POOL_SIZE);
+}
+
+/*
+ * Keep a real reserve of preallocated 64 KiB bounce chunks for the emulation
+ * fast path. GFP_ATOMIC callers must draw from the reserve instead of dipping
+ * back into the buddy allocator on every I/O, otherwise page allocation and
+ * page clearing dominate the read path.
+ */
+static void *sd_528_mempool_page_alloc(gfp_t gfp_mask, void *pool_data)
+{
+	unsigned int order = (unsigned long)pool_data;
+
+	if (!(gfp_mask & __GFP_DIRECT_RECLAIM))
+		return NULL;
+
+	return alloc_pages(gfp_mask, order);
+}
+
+static void sd_528_mempool_page_free(void *element, void *pool_data)
+{
+	unsigned int order = (unsigned long)pool_data;
+
+	__free_pages(element, order);
+}
