+static void sd_528_limit_queue_depth(struct scsi_disk *sdkp)
+{
+	struct scsi_device *sdp = sdkp->device;
+	unsigned int cap = sd_528_queue_depth_cap();
+	unsigned int target = sd_528_emulation_queue_depth;
+
+	if (!sdkp->emulate_512_from_528)
+		return;
+
+	if (!target)
+		target = cap;
+	target = min(target, cap);
+	target = min_t(unsigned int, target, sdp->host->can_queue);
+	target = min_t(unsigned int, target, 4096);
+	if (sdp->queue_depth <= target)
+		return;
+
+	scsi_change_queue_depth(sdp, target);
+}
+
+static int sd_528_advance_sg(struct scatterlist **sgp, unsigned int *sg_offp,
+			     unsigned int bytes)
+{
+	struct scatterlist *sg = *sgp;
+	unsigned int sg_off = *sg_offp;
+
+	while (bytes) {
+		unsigned int avail;
+
+		if (!sg)
+			return -EIO;
+		if (sg_off == sg->length) {
+			sg = sg_next(sg);
+			sg_off = 0;
+			continue;
+		}
+
+		avail = sg->length - sg_off;
+		if (bytes < avail) {
+			sg_off += bytes;
+			bytes = 0;
+			break;
+		}
+
+		bytes -= avail;
+		sg = sg_next(sg);
+		sg_off = 0;
+	}
+
+	*sgp = sg;
+	*sg_offp = sg_off;
+	return 0;
+}
+
+static int sd_528_zero_sg_bytes(struct scatterlist **sgp, unsigned int *sg_offp,
+				unsigned int bytes)
+{
+	struct scatterlist *sg = *sgp;
+	unsigned int sg_off = *sg_offp;
+
+	while (bytes) {
+		unsigned int chunk;
+		char *dst;
+
+		if (!sg)
+			return -EIO;
+		if (sg_off == sg->length) {
+			sg = sg_next(sg);
+			sg_off = 0;
+			continue;
+		}
+
+		chunk = min(bytes, sg->length - sg_off);
+		dst = (char *)page_address(sg_page(sg)) + sg->offset + sg_off;
+		memset(dst, 0, chunk);
+		bytes -= chunk;
+		sg_off += chunk;
+	}
+
+	*sgp = sg;
+	*sg_offp = sg_off;
+	return 0;
+}
+
+static int sd_528_pack_sg_blocks(struct scsi_data_buffer *sdb,
+				 struct sg_table *bounce_sgt,
+				 unsigned int blocks)
+{
+	struct sg_mapping_iter miter;
+	struct scatterlist *bounce_sg = bounce_sgt->sgl;
+	unsigned int bounce_off = 0;
+	size_t host_pos = 0;
+	size_t host_len = (size_t)blocks * SD_528_HOST_SECTOR_SIZE;
+
+	sg_miter_start(&miter, sdb->table.sgl, sdb->table.nents,
+		       SG_MITER_ATOMIC | SG_MITER_FROM_SG);
+	while (host_pos < host_len && sg_miter_next(&miter)) {
+		const char *src = miter.addr;
+		unsigned int src_off = 0;
+
+		while (src_off < miter.length && host_pos < host_len) {
+			size_t block_off = host_pos & (SD_528_HOST_SECTOR_SIZE - 1);
+			size_t len = min_t(size_t, host_len - host_pos,
+					   min_t(size_t, miter.length - src_off,
+						 SD_528_HOST_SECTOR_SIZE - block_off));
+			size_t remaining = len;
+			const char *buf = src + src_off;
+
+			while (remaining) {
+				unsigned int chunk;
+				char *dst;
+
+				if (!bounce_sg)
+					goto out_eio;
+				if (bounce_off == bounce_sg->length) {
+					bounce_sg = sg_next(bounce_sg);
+					bounce_off = 0;
+					continue;
+				}
+
+				chunk = min_t(size_t, remaining,
+					      bounce_sg->length - bounce_off);
+				dst = (char *)page_address(sg_page(bounce_sg)) +
+				      bounce_sg->offset + bounce_off;
+				memcpy(dst, buf, chunk);
+				buf += chunk;
+				remaining -= chunk;
+				bounce_off += chunk;
+			}
+
+			src_off += len;
+			host_pos += len;
+
+			/*
+			 * Skip the protection trailer in the emulated 528-byte
+			 * device buffer after every 512-byte payload,
+			 * zeroing it while we are already walking the bounce SG.
+			 */
+			if (block_off + len == SD_528_HOST_SECTOR_SIZE &&
+			    sd_528_zero_sg_bytes(&bounce_sg, &bounce_off,
+						 SD_528_TRAILER_BYTES))
+				goto out_eio;
+		}
+	}
+	sg_miter_stop(&miter);
+
+	return host_pos == host_len ? 0 : -EIO;
+
+out_eio:
+	sg_miter_stop(&miter);
+	return -EIO;
+}
+
+static int sd_528_unpack_sg_bytes(struct scsi_data_buffer *sdb,
+				  struct sg_table *bounce_sgt,
+				  unsigned int bytes)
+{
+	struct sg_mapping_iter miter;
+	struct scatterlist *bounce_sg = bounce_sgt->sgl;
+	unsigned int bounce_off = 0;
+	size_t host_pos = 0;
+	size_t host_len = bytes;
+
+	sg_miter_start(&miter, sdb->table.sgl, sdb->table.nents,
+		       SG_MITER_ATOMIC | SG_MITER_TO_SG);
+	while (host_pos < host_len && sg_miter_next(&miter)) {
+		char *dst = miter.addr;
+		unsigned int dst_off = 0;
+
+		while (dst_off < miter.length && host_pos < host_len) {
+			size_t block_off = host_pos & (SD_528_HOST_SECTOR_SIZE - 1);
+			size_t len = min_t(size_t, host_len - host_pos,
+					   min_t(size_t, miter.length - dst_off,
+						 SD_528_HOST_SECTOR_SIZE - block_off));
+			size_t remaining = len;
+			char *buf = dst + dst_off;
+
+			while (remaining) {
+				unsigned int chunk;
+				char *src;
+
+				if (!bounce_sg)
+					goto out_eio;
+				if (bounce_off == bounce_sg->length) {
+					bounce_sg = sg_next(bounce_sg);
+					bounce_off = 0;
+					continue;
+				}
+
+				chunk = min_t(size_t, remaining,
+					      bounce_sg->length - bounce_off);
+				src = (char *)page_address(sg_page(bounce_sg)) +
+				      bounce_sg->offset + bounce_off;
+				memcpy(buf, src, chunk);
+				buf += chunk;
+				remaining -= chunk;
+				bounce_off += chunk;
+			}
+
+			dst_off += len;
+			host_pos += len;
+
+			if (block_off + len == SD_528_HOST_SECTOR_SIZE &&
+			    sd_528_advance_sg(&bounce_sg, &bounce_off,
+					      SD_528_TRAILER_BYTES))
+				goto out_eio;
+		}
+	}
+	sg_miter_stop(&miter);
+
+	return host_pos == host_len ? 0 : -EIO;
+
+out_eio:
+	sg_miter_stop(&miter);
+	return -EIO;
+}
+
+static void sd_528_release_emulation_ctx(struct sd_528_emulation_ctx *ctx)
+{
+	unsigned int i;
+
+	if (!ctx)
+		return;
+
+	for (i = 0; i < ctx->nr_chunks; i++) {
+		if (ctx->chunks[i].page)
+			mempool_free(ctx->chunks[i].page, sd_528_page_pool);
+		ctx->chunks[i].page = NULL;
+	}
+	ctx->nr_chunks = 0;
+	mempool_free(ctx, sd_528_ctx_pool);
+}
+
+static void sd_528_free_emulation(struct request *rq)
+{
+	struct sd_528_emulation_ctx *ctx = rq->end_io_data;
+
+	if (!ctx)
+		return;
+
+	rq->end_io_data = NULL;
+	sd_528_release_emulation_ctx(ctx);
+}
+
+static void sd_528_init_emulation_sg(struct sd_528_emulation_ctx *ctx)
+{
+	struct scatterlist *sg;
+	unsigned int i;
+
+	sg_init_table(ctx->bounce_sgl, ctx->nr_chunks);
+	ctx->bounce_sgt.sgl = ctx->bounce_sgl;
+	ctx->bounce_sgt.nents = ctx->nr_chunks;
+	ctx->bounce_sgt.orig_nents = ctx->nr_chunks;
+	for_each_sg(ctx->bounce_sgl, sg, ctx->nr_chunks, i)
+		sg_set_page(sg, ctx->chunks[i].page, ctx->chunks[i].len, 0);
+}
+
+static blk_status_t sd_528_alloc_emulation_buffer(struct sd_528_emulation_ctx *ctx)
+{
+	unsigned int remaining = ctx->dev_len;
+	unsigned int i = 0;
+
+	while (remaining) {
+		struct page *page;
+		unsigned int len;
+
+		page = mempool_alloc(sd_528_page_pool, GFP_ATOMIC);
+		if (!page)
+			return BLK_STS_RESOURCE;
+
+		len = min(remaining, SD_528_CHUNK_USED_BYTES);
+		ctx->chunks[i].page = page;
+		ctx->chunks[i].len = len;
+		ctx->nr_chunks = ++i;
+		remaining -= len;
+	}
+
+	sd_528_init_emulation_sg(ctx);
+	return BLK_STS_OK;
+}
+
+static blk_status_t sd_528_prepare_emulation(struct scsi_cmnd *cmd, bool write)
+{
+	struct request *rq = scsi_cmd_to_rq(cmd);
+	struct sd_528_emulation_ctx *ctx;
+	unsigned int blocks = blk_rq_bytes(rq) >> 9;
+	unsigned int bounce_segments = sd_528_blocks_to_chunks(blocks);
+	int ret;
+
+	if (blocks > SD_528_MAX_HOST_SECTORS)
+		return BLK_STS_IOERR;
+
+	if (rq->q->limits.max_segments &&
+	    bounce_segments > rq->q->limits.max_segments)
+		return BLK_STS_IOERR;
+
+	ctx = mempool_alloc(sd_528_ctx_pool, GFP_ATOMIC);
+	if (!ctx)
+		return BLK_STS_RESOURCE;
+
+	ctx->host_len = blocks * SD_528_HOST_SECTOR_SIZE;
+	ctx->dev_len = blocks * SD_528_DEV_SECTOR_SIZE;
+	ctx->nr_chunks = 0;
+	ctx->bounce_sgt.sgl = ctx->bounce_sgl;
+	ctx->bounce_sgt.nents = 0;
+	ctx->bounce_sgt.orig_nents = 0;
+
+	ret = sd_528_alloc_emulation_buffer(ctx);
+	if (ret != BLK_STS_OK)
+		goto resource;
+
+	if (write) {
+		ret = sd_528_pack_sg_blocks(&cmd->sdb, &ctx->bounce_sgt,
+					    blocks);
+		if (ret)
+			goto ioerr;
+	}
+
+	ctx->orig_sdb = cmd->sdb;
+	cmd->sdb.table = ctx->bounce_sgt;
+	cmd->sdb.length = ctx->dev_len;
+	rq->end_io_data = ctx;
+	return BLK_STS_OK;
+
+resource:
+	sd_528_release_emulation_ctx(ctx);
+	return BLK_STS_RESOURCE;
+ioerr:
+	sd_528_release_emulation_ctx(ctx);
+	return BLK_STS_IOERR;
+}
+
+static unsigned int sd_528_complete_emulation(struct scsi_cmnd *cmd,
+					      unsigned int good_bytes,
+					      int result)
+{
+	struct request *rq = scsi_cmd_to_rq(cmd);
+	struct sd_528_emulation_ctx *ctx = rq->end_io_data;
+	unsigned int copy_bytes;
+	int ret;
+
+	if (!ctx)
+		return good_bytes;
+
+	if (req_op(rq) == REQ_OP_READ) {
+		copy_bytes = min(good_bytes, ctx->host_len);
+		copy_bytes &= ~(SD_528_HOST_SECTOR_SIZE - 1);
+		ret = sd_528_unpack_sg_bytes(&ctx->orig_sdb, &ctx->bounce_sgt,
+					     copy_bytes);
+		if (ret) {
+			set_host_byte(cmd, DID_ERROR);
+			result = cmd->result;
+			good_bytes = 0;
+		} else {
+			good_bytes = copy_bytes;
+		}
+	}
+
+	cmd->sdb = ctx->orig_sdb;
+	if (!result) {
+		scsi_set_resid(cmd, 0);
+		return ctx->host_len;
+	}
+
+	scsi_set_resid(cmd, ctx->host_len);
+	return 0;
+}
