+static unsigned int sd_adjust_logical_sector_size(struct scsi_disk *sdkp,
+						  unsigned int sector_size)
+{
+	sdkp->device_sector_size = sector_size;
+	sdkp->emulate_512_from_fat = 0;
+	sdkp->emulate_512_from_528 = 0;
+
+	switch (sector_size) {
+	case 520:
+		if (!sd_emulate_512_from_fat_sectors)
+			return sector_size;
+
+		sd_printk(KERN_NOTICE, sdkp,
+			  "Forcing %u-byte sectors to 512-byte host sectors; transport must strip %u trailing metadata bytes per block.\n",
+			  sector_size, sector_size - 512);
+		sdkp->emulate_512_from_fat = 1;
+		sdkp->protection_type = 0;
+		sdkp->physical_block_size = 512;
+		return 512;
+	case 528:
+		if (!sd_emulate_512_from_fat_sectors)
+			return sector_size;
+
+		sdkp->emulate_512_from_fat = 1;
+		sdkp->emulate_512_from_528 = 1;
+		sdkp->protection_type = 0;
+		sdkp->physical_block_size = 512;
+		return 512;
+	default:
+		return sector_size;
+	}
+}
