#!/bin/sh
# /init for the busybox initramfs built by run-qemu.sh. Exercises the 528
# emulation on a scsi_debug disk with 528-byte sectors and prints one line per
# test. Error injection goes through scsi_debug's debugfs "error" file
# (type count opcode host driver status sense-key asc ascq) and its every_nth
# and opts knobs. Every data check compares against a known pattern.
mount -t proc p /proc; mount -t sysfs s /sys; mount -t devtmpfs d /dev 2>/dev/null
mount -t debugfs d /sys/kernel/debug; mount -t tmpfs t /tmp
echo "=== TESTSTART"
T=basic
for a in $(cat /proc/cmdline); do case $a in t=*) T=${a#t=};; esac; done

if [ $T = xver ]; then
# Old and new sd_mod over the same disk, swapped at runtime. Needs a kernel
# with BLK_DEV_SD=m and SCSI_DEBUG=m, and /mods/{sd-old,sd-new,scsi_debug}.ko
# (MODS= for run-qemu.sh). The disk keeps its contents across the swaps, so
# this is exactly an upgrade from the old kernel to the new one and back.
SDP="emulate_512_from_fat_sectors=1 emulate_528_max_sectors=256 emulate_528_queue_depth=32 emulate_528_pool_chunks=4608 emulate_528_pool_contexts=512"
insmod /mods/scsi_debug.ko sector_size=528 dev_size_mb=64 physblk_exp=3 lbpu=1 lbprz=1
load() { insmod /mods/sd-$1.ko $SDP; i=0; while [ ! -b /dev/sda ] && [ $i -lt 50 ]; do usleep 100000; i=$((i+1)); done; sleep 1; }
unload() { sync; rmmod sd_mod; sleep 1; }
props() {
  r="$1:"; for f in size queue/logical_block_size queue/physical_block_size queue/max_sectors_kb \
      device/queue_depth queue/discard_max_bytes queue/discard_granularity \
      queue/write_zeroes_max_bytes queue/rotational integrity/format; do
    r="$r $(basename $f)=$(cat /sys/block/sda/$f 2>/dev/null)"; done; echo "$r"
}
hdev() { dd if=/dev/sda bs=64k iflag=direct 2>/dev/null | md5sum | head -c 32; }
hraw() { rawrd /dev/sda 0 $(cat /sys/block/sda/size) | md5sum | head -c 32; }
ck() { [ "$2" = "$3" ] && echo "$1: OK" || echo "$1: FAIL ($2 != $3)"; }

N=127100
dd if=/dev/urandom of=/tmp/P bs=512 count=$N 2>/dev/null
dd if=/dev/urandom of=/tmp/Q bs=512 count=8192 2>/dev/null
cp /tmp/P /tmp/E; dd if=/tmp/Q of=/tmp/E bs=512 seek=50001 conv=notrunc 2>/dev/null
HP=$(md5sum < /tmp/P | head -c 32); HE=$(md5sum < /tmp/E | head -c 32)

load old; props old
dd if=/tmp/P of=/dev/sda bs=128k oflag=direct 2>/dev/null
dd if=/tmp/P of=/dev/sda bs=512 skip=2049 seek=2049 count=17 oflag=direct 2>/dev/null
ck "X1 old kernel writes and reads P" $(hdev) $HP
R_OLD_P=$(hraw); echo "   raw image written by old: $R_OLD_P"
unload

load new; props new
ck "X2 new kernel reads data written by old" $(hdev) $HP
ck "X3 loading new changed nothing on the medium" $(hraw) $R_OLD_P
dd if=/tmp/P of=/dev/sda bs=1M oflag=direct 2>/dev/null
dd if=/tmp/P of=/dev/sda bs=4k skip=3 seek=3 count=1000 oflag=direct 2>/dev/null
dd if=/tmp/P of=/dev/sda bs=512 skip=2049 seek=2049 count=17 oflag=direct 2>/dev/null
ck "X4 same data written by new: raw image identical to old's, trailers included" $(hraw) $R_OLD_P
dd if=/tmp/Q of=/dev/sda bs=512 seek=50001 oflag=direct 2>/dev/null
ck "X5 new kernel writes Q over P" $(hdev) $HE
R_NEW_E=$(hraw)
unload

load old; props old
ck "X6 rollback: old kernel reads what new wrote" $(hdev) $HE
dd if=/tmp/E of=/dev/sda bs=128k oflag=direct 2>/dev/null
ck "X7 same data written by old: raw image identical to new's" $(hraw) $R_NEW_E
unload

load new
ck "X8 forward again: new reads old's rewrite" $(hdev) $HE
unload
echo "=== TESTEND"
dmesg | grep -E "KASAN|BUG:|WARNING:|Oops" | head -20
reboot -f
fi

if [ $T = xverify ]; then
# verify_upgrade.sh itself: snapshot under the old sd_mod, compare under the
# new one, then change one sector and make sure compare notices.
SDP="emulate_512_from_fat_sectors=1 emulate_528_max_sectors=256"
insmod /mods/scsi_debug.ko sector_size=528 dev_size_mb=64 virtual_gb=3 physblk_exp=3
load() { insmod /mods/sd-$1.ko $SDP; i=0; while [ ! -b /dev/sda ] && [ $i -lt 50 ]; do usleep 100000; i=$((i+1)); done; sleep 1; }
dd if=/dev/urandom of=/tmp/P bs=1M count=64 2>/dev/null
load old
dd if=/tmp/P of=/dev/sda bs=1M oflag=direct 2>/dev/null; sync
sh /bin/verify_upgrade.sh snapshot /tmp/snap.txt --sample 3 /dev/sda; echo "   snapshot exit $?"
grep -c . /tmp/snap.txt
rmmod sd_mod; sleep 1; load new
sh /bin/verify_upgrade.sh compare /tmp/snap.txt; echo "V1 compare under new kernel exit $? (0 expected)"
dd if=/dev/urandom of=/dev/sda bs=512 seek=12345 count=1 oflag=direct 2>/dev/null
sh /bin/verify_upgrade.sh compare /tmp/snap.txt; echo "V2 compare after changing one sector exit $? (1 expected)"
sh /bin/verify_upgrade.sh snapshot /tmp/snap.txt /dev/sda >/dev/null 2>&1; echo "V3 refuses to overwrite an existing snapshot: exit $? (2 expected)"
echo "=== TESTEND"
dmesg | grep -E "KASAN|BUG:|WARNING:|Oops" | head -20
reboot -f
fi

echo "size=$(cat /sys/block/sda/size) lbs=$(cat /sys/block/sda/queue/logical_block_size)" \
     "max_kb=$(cat /sys/block/sda/queue/max_sectors_kb) qd=$(cat /sys/block/sda/device/queue_depth)"
E=/sys/kernel/debug/scsi_debug/0:0:0:0/error
D=/sys/bus/pseudo/drivers/scsi_debug
echo "scenario: $T dma_alignment=$(cat /sys/block/sda/queue/dma_alignment 2>/dev/null)"

# random faults while I/O runs: resets, unit attentions, host busy, short
# transfers, transport errors, recovered errors and rescans
inject_loop() {
  while [ ! -f /tmp/stop ]; do
    case $((RANDOM % 9)) in
      0) echo "2 -1 0x28 0x08 0 0 0 0 0" > $E ;;
      1) echo "2 -1 0x2a 0x08 0 0 0 0 0" > $E ;;
      2) echo "2 -1 0x28 0 0 2 6 0x29 0" > $E ;;
      3) echo "2 -1 0x2a 0 0 2 6 0x29 0" > $E ;;
      4) echo "1 -3 0x2a 0x1055" > $E ;;
      5) echo 5 > $D/every_nth; echo 0x100 > $D/opts ;;
      6) echo 5 > $D/every_nth; echo 16 > $D/opts ;;
      7) echo 5 > $D/every_nth; echo 8 > $D/opts ;;
      8) echo 1 > /sys/block/sda/device/rescan ;;
    esac
    usleep $((100000 + RANDOM % 300000))
    echo 0 > $D/opts; echo 0 > $D/every_nth
  done
  for c in 0x28 0x2a; do echo "- 2 $c" > $E; echo "- 1 $c" > $E; done 2>/dev/null
}

zero_chk() { # $1 name $2 start $3 count (sectors): all zero?
  dd if=/dev/sda of=/tmp/r bs=512 skip=$2 count=$3 iflag=direct 2>/dev/null
  dd if=/dev/zero of=/tmp/z bs=512 count=$3 2>/dev/null
  cmp /tmp/z /tmp/r >/dev/null && echo "$1: OK (zeros)" || echo "$1: FAIL (not zero)"
}
pat_chk() { # $1 name $2 start $3 count (sectors): matches /tmp/pat?
  dd if=/dev/sda of=/tmp/r bs=512 skip=$2 count=$3 iflag=direct 2>/dev/null
  dd if=/tmp/pat of=/tmp/p bs=512 skip=$2 count=$3 2>/dev/null
  cmp /tmp/p /tmp/r >/dev/null && echo "$1: OK" || echo "$1: FAIL (data mismatch)"
}

case $T in
torture)
  # 64-byte iovecs reach the driver only on kernels that allow sub-sector
  # O_DIRECT segments (7.0); older ones fail them with EINVAL in the block
  # layer before the driver sees them, so T20b repeats the run with 512.
  torture /dev/sda 4 60 64 & tp=$!
  sleep 5; inject_loop & ip=$!
  wait $tp; echo "T20 torture exit: $?"; touch /tmp/stop; wait $ip
  rm -f /tmp/stop
  torture /dev/sda 4 60 512 & tp=$!
  sleep 5; inject_loop & ip=$!
  wait $tp; echo "T20b torture, 512-byte iovecs, exit: $?"; touch /tmp/stop; wait $ip
  torture /dev/sda 8 20 64; echo "T21 torture, no faults, exit: $?"
  torture /dev/sda 8 20 512; echo "T22 torture, no faults, 512-byte iovecs, exit: $?"
  ;;
trim)
  echo "discard_max=$(cat /sys/block/sda/queue/discard_max_bytes) gran=$(cat /sys/block/sda/queue/discard_granularity)" \
       "write_zeroes_max=$(cat /sys/block/sda/queue/write_zeroes_max_bytes)"
  dd if=/dev/urandom of=/tmp/pat bs=1M count=16 2>/dev/null
  dd if=/tmp/pat of=/dev/sda bs=1M oflag=direct 2>/dev/null
  blkops /dev/sda discard 2048 4096; echo "   discard exit $?"
  zero_chk "T30 discarded range reads zero (LBPRZ)" 2048 4096
  pat_chk "T30b before range intact" 0 2048
  pat_chk "T30c after range intact" 6144 2048
  rawrd /dev/sda 3000 | od -An -v -tx1 | tr -d ' \n' | grep -q '^0*$' && echo "T31 raw 528-byte block after discard: OK (zeros)" || echo "T31: FAIL"
  blkops /dev/sda zeroout 10000 300; echo "   zeroout exit $?"
  zero_chk "T32 zeroout range" 10000 300
  pat_chk "T32b around zeroout intact" 9000 1000
  pat_chk "T32c around zeroout intact" 10300 700
  blkops /dev/sda discard 20003 8; echo "   unaligned discard exit $?"
  pat_chk "T33 sectors before unaligned discard intact" 19000 1003
  pat_chk "T33b sectors after unaligned discard intact" 20011 989
  torture /dev/sda 2 5 64 >/dev/null; blkops /dev/sda discard 0 32768
  torture /dev/sda 4 20 64; echo "T34 torture after full discard, exit: $?"
  ;;
eh)
  echo 4 > /sys/block/sda/device/timeout
  dd if=/dev/urandom of=/tmp/pat bs=1M count=8 2>/dev/null
  dd if=/tmp/pat of=/dev/sda bs=128k oflag=direct 2>/dev/null
  echo "0 -1 0x28" > $E; pat_chk "T40 read + command timeout (EH abort)" 768 256
  dd if=/dev/urandom of=/tmp/pat2 bs=128k count=1 2>/dev/null
  echo "0 -1 0x2a" > $E
  dd if=/tmp/pat2 of=/dev/sda bs=128k seek=10 count=1 oflag=direct 2>/dev/null; echo "   dd exit $?"
  dd if=/dev/sda of=/tmp/r bs=128k skip=10 count=1 iflag=direct 2>/dev/null
  cmp /tmp/pat2 /tmp/r >/dev/null && echo "T41 write + command timeout: OK" || echo "T41 write + command timeout: FAIL"
  echo "1 -5 0x2a 0x1055" > $E
  dd if=/tmp/pat2 of=/dev/sda bs=128k seek=20 count=1 oflag=direct 2>/dev/null
  dd if=/dev/sda of=/tmp/r bs=128k skip=20 count=1 iflag=direct 2>/dev/null
  cmp /tmp/pat2 /tmp/r >/dev/null && echo "T42 write + host busy requeue: OK" || echo "T42: FAIL"
  torture /dev/sda 4 30 64 & tp=$!
  while kill -0 $tp 2>/dev/null; do echo 1 > /sys/block/sda/device/rescan; usleep 50000; done
  wait $tp; echo "T43 torture during continuous rescans, exit: $?"
  ;;
pool)
  echo "pool test: chunks=$(cat /sys/module/sd_mod/parameters/emulate_528_pool_chunks) max_kb=$(cat /sys/block/sda/queue/max_sectors_kb)"
  timeout 30 dd if=/dev/sda of=/dev/null bs=1M count=4 iflag=direct 2>/dev/null
  r=$?; [ $r = 0 ] && echo "T50 1 MiB read with tiny pool: OK" || echo "T50 1 MiB read with tiny pool: HANG/FAIL (exit $r)"
  ;;
big)
  echo "max_kb=$(cat /sys/block/sda/queue/max_sectors_kb) max_hw_kb=$(cat /sys/block/sda/queue/max_hw_sectors_kb)"
  dd if=/dev/urandom of=/tmp/pat bs=1M count=16 2>/dev/null
  dd if=/tmp/pat of=/dev/sda bs=2M oflag=direct 2>/dev/null
  dd if=/dev/sda of=/tmp/rd bs=2M count=8 iflag=direct 2>/dev/null
  cmp /tmp/pat /tmp/rd >/dev/null && echo "T60 2 MiB requests: OK" || echo "T60 2 MiB requests: FAIL"
  echo "2 -1 0x28 0x08 0 0 0 0 0" > $E
  dd if=/dev/sda of=/tmp/rd bs=2M count=8 iflag=direct 2>/dev/null
  cmp /tmp/pat /tmp/rd >/dev/null && echo "T61 2 MiB read + DID_RESET: OK" || echo "T61: FAIL"
  torture /dev/sda 4 30 64 & tp=$!
  sleep 3; inject_loop & ip=$!
  wait $tp; echo "T62 torture with faults at max request size, exit: $?"; touch /tmp/stop; wait $ip
  ;;
cdb16)
  echo "size=$(cat /sys/block/sda/size) (> 2^32 blocks -> READ/WRITE(16))"
  dd if=/dev/urandom of=/tmp/pat bs=128k count=1 2>/dev/null
  for lba in 8 5000000000; do
    dd if=/tmp/pat of=/dev/sda bs=512 seek=$lba count=256 oflag=direct 2>/dev/null
    echo "2 -1 0x88 0x08 0 0 0 0 0" > $E
    dd if=/dev/sda of=/tmp/r bs=512 skip=$lba count=256 iflag=direct 2>/dev/null
    cmp /tmp/pat /tmp/r >/dev/null && echo "T70 READ(16) + DID_RESET at $lba: OK" || echo "T70 at $lba: FAIL"
    echo "2 -1 0x8a 0 0 2 6 0x29 0" > $E
    dd if=/tmp/pat of=/dev/sda bs=512 seek=$((lba+512)) count=256 oflag=direct 2>/dev/null
    dd if=/dev/sda of=/tmp/r bs=512 skip=$((lba+512)) count=256 iflag=direct 2>/dev/null
    cmp /tmp/pat /tmp/r >/dev/null && echo "T71 WRITE(16) + UA at $lba: OK" || echo "T71 at $lba: FAIL"
  done
  ;;
basic)

dd if=/dev/urandom of=/tmp/pat bs=1M count=8 2>/dev/null
dd if=/tmp/pat of=/dev/sda bs=128k oflag=direct 2>/dev/null; sync
dd if=/dev/sda of=/tmp/rd bs=128k count=64 iflag=direct 2>/dev/null
cmp /tmp/pat /tmp/rd && echo "T1 baseline integrity: OK" || echo "T1 baseline integrity: FAIL"

chk() { # $1 name, $2 offset in 128k units: read back and compare with /tmp/pat
  dd if=/dev/sda of=/tmp/r bs=128k skip=$2 count=1 iflag=direct 2>/dev/null
  dd if=/tmp/pat of=/tmp/p bs=128k skip=$2 count=1 2>/dev/null
  cmp /tmp/p /tmp/r >/dev/null 2>&1 && echo "$1: OK" || echo "$1: FAIL (data mismatch)"
}
# READ hit once by a host reset / unit attention: the core retries the same
# command without preparing it again
echo "2 -1 0x28 0x08 0 0 0 0 0" > $E; chk "T2 read + DID_RESET" 3
echo "2 -1 0x28 0 0 2 6 0x29 0" > $E; chk "T3 read + UNIT ATTENTION" 5

dd if=/dev/urandom of=/tmp/pat2 bs=128k count=1 2>/dev/null
wr() { # $1 name $2 offset $3 injection: write /tmp/pat2, verify it and the next block
  echo "$3" > $E
  dd if=/tmp/pat2 of=/dev/sda bs=128k seek=$2 count=1 oflag=direct 2>/dev/null; echo "   dd exit $?"
  dd if=/dev/sda of=/tmp/r bs=128k skip=$2 count=1 iflag=direct 2>/dev/null
  cmp /tmp/pat2 /tmp/r >/dev/null 2>&1 && echo "$1: OK" || echo "$1: FAIL (data mismatch)"
  dd if=/dev/sda of=/tmp/r bs=128k skip=$(($2+1)) count=1 iflag=direct 2>/dev/null
  dd if=/tmp/pat of=/tmp/p bs=128k skip=$(($2+1)) count=1 2>/dev/null
  cmp /tmp/p /tmp/r >/dev/null 2>&1 && echo "$1 neighbour: OK" || echo "$1 neighbour: FAIL"
}
wr "T4 write + DID_RESET" 10 "2 -1 0x2a 0x08 0 0 0 0 0"
wr "T5 write + UNIT ATTENTION" 20 "2 -1 0x2a 0 0 2 6 0x29 0"
# T6/T7: this injection returns RECOVERED ERROR *without* running the command,
# which a real device never does. A stock 512-byte disk "fails" these the same
# way; they are here to show that the emulation now matches stock sd.
wr "T6 write + injected RECOVERED ERROR (see note)" 30 "2 -1 0x2a 0 0 2 1 0x17 0"
echo "2 -1 0x28 0 0 2 1 0x17 0" > $E; chk "T7 read + injected RECOVERED ERROR (see note)" 7

dd if=/dev/urandom of=/tmp/pat bs=1M count=8 2>/dev/null
for i in 0 1 2 3 4 5 6 7; do
  dd if=/tmp/pat of=/dev/sda bs=64k skip=$((i*16)) seek=$((i*16)) count=16 oflag=direct 2>/dev/null &
done; wait
dd if=/dev/sda of=/tmp/rd bs=1M count=8 iflag=direct 2>/dev/null
cmp /tmp/pat /tmp/rd && echo "T8 parallel integrity: OK" || echo "T8 parallel integrity: FAIL"

dd if=/tmp/pat of=/dev/sda bs=512 skip=100 seek=2049 count=17 oflag=direct 2>/dev/null
dd if=/dev/sda of=/tmp/r bs=512 skip=2049 count=17 iflag=direct 2>/dev/null
dd if=/tmp/pat of=/tmp/p bs=512 skip=100 count=17 2>/dev/null
cmp /tmp/p /tmp/r && echo "T9 unaligned 17 sectors: OK" || echo "T9 unaligned 17 sectors: FAIL"

# on-disk layout: host LBA N -> device LBA N, 512 data bytes + 16 zero bytes
dd if=/tmp/pat of=/dev/sda bs=512 skip=7 seek=1000 count=3 oflag=direct 2>/dev/null
for n in 0 1 2; do
  rawrd /dev/sda $((1000+n)) > /tmp/raw
  dd if=/tmp/raw of=/tmp/rd bs=512 count=1 2>/dev/null
  dd if=/tmp/pat of=/tmp/p bs=512 skip=$((7+n)) count=1 2>/dev/null
  t=$(dd if=/tmp/raw bs=1 skip=512 2>/dev/null | od -An -tx1 | tr -d ' \n')
  cmp /tmp/p /tmp/rd >/dev/null && echo "T17 layout LBA $((1000+n)): OK trailer=$t" \
                                || echo "T17 layout LBA $((1000+n)): FAIL"
done

# scsi_debug's own injections, which do run the command
dd if=/dev/urandom of=/tmp/pat bs=1M count=8 2>/dev/null
dd if=/tmp/pat of=/dev/sda bs=128k oflag=direct 2>/dev/null
echo 3 > $D/every_nth; echo 0x100 > $D/opts      # short transfer: half the data, resid set, GOOD status
dd if=/dev/sda of=/tmp/rd bs=128k count=64 iflag=direct 2>/dev/null
echo 0 > $D/opts; echo 0 > $D/every_nth
cmp /tmp/pat /tmp/rd >/dev/null && echo "T13 read with short transfers (resid): OK" \
                                || echo "T13 read with short transfers (resid): FAIL"
echo 2 > $D/every_nth; echo 8 > $D/opts          # RECOVERED ERROR after the data moved
dd if=/tmp/pat of=/dev/sda bs=128k oflag=direct 2>/dev/null
dd if=/dev/sda of=/tmp/rd bs=128k count=64 iflag=direct 2>/dev/null
echo 0 > $D/opts; echo 0 > $D/every_nth
cmp /tmp/pat /tmp/rd >/dev/null && echo "T14 real RECOVERED ERROR: OK" || echo "T14 real RECOVERED ERROR: FAIL"
echo 2 > $D/every_nth; echo 16 > $D/opts         # ABORTED COMMAND, transport problem
dd if=/tmp/pat of=/dev/sda bs=128k oflag=direct 2>/dev/null
dd if=/dev/sda of=/tmp/rd bs=128k count=64 iflag=direct 2>/dev/null
echo 0 > $D/opts; echo 0 > $D/every_nth
cmp /tmp/pat /tmp/rd >/dev/null && echo "T15 transport errors: OK" || echo "T15 transport errors: FAIL"
echo 2 > $D/opts                                 # medium error at LBA 0x1234..
dd if=/dev/sda of=/tmp/r bs=512 skip=4600 count=128 iflag=direct 2>/dev/null
echo "T16 read over medium error: dd exit $? (non-zero expected)"
dd if=/dev/sda of=/tmp/r bs=512 skip=8000 count=128 iflag=direct 2>/dev/null
echo "T16b read elsewhere: dd exit $? (0 expected)"
echo 0 > $D/opts

echo "T10 physical_block_size: $(cat /sys/block/sda/queue/physical_block_size)"
echo 0 > /sys/module/sd_mod/parameters/emulate_512_from_fat_sectors
echo 1 > /sys/block/sda/device/rescan; sleep 1
echo "T11 size after param off + rescan: $(cat /sys/block/sda/size) (127100 = emulation kept)"
echo 1 > /sys/module/sd_mod/parameters/emulate_512_from_fat_sectors
echo 1 > /sys/block/sda/device/rescan; sleep 1
chk "T11b data after rescan" 2

# last, because the unfixed driver oopses here: take the disk offline while
# prepared commands sit on the requeue list (host busy on every READ)
echo "1 -100000 0x28 0x1055" > $E
dd if=/dev/sda of=/dev/null bs=128k count=8 iflag=direct 2>/dev/null &
sleep 2; echo offline > /sys/block/sda/device/state; sleep 1; echo "- 1 0x28" > $E; sleep 2
echo "T12 offline with requeued commands: survived"
;;
esac
echo "=== TESTEND"
dmesg | grep -E "KASAN|BUG:|WARNING:|Oops" | head -20
reboot -f
